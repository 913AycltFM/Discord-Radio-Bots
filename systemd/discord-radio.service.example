[Unit]
Description=Discord Radio Bots
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USERNAME
WorkingDirectory=/home/YOUR_LINUX_USERNAME/discord-radio
ExecStart=/home/YOUR_LINUX_USERNAME/discord-radio/venv/bin/python /home/YOUR_LINUX_USERNAME/discord-radio/main.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
